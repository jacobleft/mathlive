{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "./src",
    "./test",
    "./examples",
    "./*.js",
    "**/*.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.less"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "declarations",
    "temp-docs"
  ]
}
